<mujoco model="xarm6 scene">
  <include file="xarm6_gripper.xml"/>

  <statistic center="0.2 0 0.4" extent="1.0" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 5 cm red cube, 0.4 m in front of the arm base, well inside the reach. -->
    <body name="red_block" pos="0.4 0 0.025">
      <freejoint name="red_block_joint"/>
      <geom name="red_block" type="box" size="0.025 0.025 0.025" mass="0.1" rgba="0.85 0.1 0.1 1"
        friction="1 0.005 0.0001"/>
    </body>
  </worldbody>

  <!-- Home pose: tool pointing straight down, fingertips ~30 cm above the block, gripper open.
       (At all-zero joint angles the gripper would start inside the floor.)
       qpos = 6 arm joints, 6 gripper linkage joints, block free joint (xyz + quaternion). -->
  <keyframe>
    <key name="home"
      qpos="0 -0.3 -1.2 0 1.5 0
            0 0 0 0 0 0
            0.4 0 0.025 1 0 0 0"
      ctrl="0 -0.3 -1.2 0 1.5 0 0"/>
  </keyframe>
</mujoco>
